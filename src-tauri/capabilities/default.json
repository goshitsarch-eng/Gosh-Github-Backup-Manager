{
  "identifier": "main",
  "description": "Main window permissions for backend commands and required plugins.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "shell:allow-open",
    "allow-github-validate-token",
    "allow-github-get-user",
    "allow-github-get-repos",
    "allow-github-get-orgs",
    "allow-github-get-events",
    "allow-github-get-stats",
    "allow-backup-start",
    "allow-backup-cancel",
    "allow-backup-get-history",
    "allow-archive-create",
    "allow-archive-cancel",
    "allow-settings-get",
    "allow-settings-set",
    "allow-settings-get-token",
    "allow-settings-set-token",
    "allow-settings-clear-token"
  ],
  "remote": {
    "urls": ["http://localhost:5173"]
  }
}
